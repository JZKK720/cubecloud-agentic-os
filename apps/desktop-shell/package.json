{
  "name": "@cubecloud/desktop-shell",
  "private": true,
  "productName": "Agent Desktop",
  "version": "0.1.0",
  "main": "out/main/index.js",
  "description": "Agent Desktop — desktop shell for Cubecloud Agentic-OS",
  "author": "Cubecloud Contributors",
  "license": "(AGPL-3.0-or-later OR Apache-2.0 OR MIT) WITH framework-MIT-exception",
  "licenses": [
    { "type": "AGPL-3.0-or-later", "url": "https://www.gnu.org/licenses/agpl-3.0.html" },
    { "type": "Apache-2.0", "url": "https://www.apache.org/licenses/LICENSE-2.0" },
    { "type": "MIT", "url": "https://opensource.org/licenses/MIT" }
  ],
  "homepage": "https://github.com/cubecloud-contributors/cubecloud-agentic-os",
  "repository": {
    "type": "git",
    "url": "https://github.com/cubecloud-contributors/cubecloud-agentic-os.git"
  },
  "bugs": {
    "url": "https://github.com/cubecloud-contributors/cubecloud-agentic-os/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:electron-smoke": "vitest run src/main/hermesElectron.smoke.test.ts",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && node build/run-electron-builder.cjs --config electron-builder.yml --dir --win",
    "build:win": "npm run build && node build/run-electron-builder.cjs --config electron-builder.yml --win",
    "verify:win-package": "powershell -NoProfile -ExecutionPolicy Bypass -File build/verify-windows-package.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "0.9.8",
    "better-sqlite3": "^12.8.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.8"
  }
}
