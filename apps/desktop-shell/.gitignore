#
# apps/desktop-shell/.gitignore \u2014 local ignores for the @cubecloud/desktop-shell
# workspace. The outer repo's .gitignore covers the cross-cutting patterns
# (node_modules/, dist/, out/, *.tsbuildinfo). This file is for things that
# are workspace-specific.

# Vitest coverage output
coverage/

# vite cache
.vite/

# Local dev artifacts
*.log
npm-debug.log*

# Test artifacts
.vitest-cache/
