# Console kernel — environment for `compose.console.yaml`.
#
# Copy to `.env` beside the compose file (`.env` is gitignored):
#
#   cp .env.console.example .env
#
# Compose reads this file automatically. Nothing here is required to boot
# the kernel — it starts and serves without any of it. These values decide
# whether the kernel can actually *run an AI turn*, which is a different
# thing from being up.

# ── Runtime gateway ──────────────────────────────────────────────────────
# Where the kernel finds the agent runtime it attaches to.
#
# The desktop and the kernel both speak the same OpenAI-compatible
# gateway. On the host that is Hermes on 127.0.0.1:8642 — but a container's
# loopback is its own, so 127.0.0.1 inside the kernel resolves to nothing
# and every turn fails. `host.docker.internal` reaches the host's loopback
# through the `extra_hosts: host-gateway` entry already in the compose file.
#
# This is the intended architecture: the kernel does not embed a runtime,
# it attaches to one over HTTP. Point it at a different host:port to use a
# different runtime or a remote gateway.
CONSOLE_RUNTIME_BASE_URL=http://host.docker.internal:8642

# ── Gateway bearer ───────────────────────────────────────────────────────
# The gateway's shared secret, sent as `Authorization: Bearer <key>`.
#
# Without it the kernel sends no auth header and the gateway answers
# 401 gateway_auth_failed. Hermes keeps the live value in
# `<HERMES_HOME>/.env` as `API_SERVER_KEY` — note that a container's
# *environment* may hold a stale copy, so read the file, not
# `docker inspect`.
#
#   source: Hermes container
#     docker exec hermes-gateway sh -c 'grep ^API_SERVER_KEY= /opt/data/.env'
#
# Leave unset only if the gateway has no auth configured.
HERMES_API_SERVER_KEY=

# ── Kernel HTTP surface ──────────────────────────────────────────────────
# Fixed token for the kernel's own HTTP API (`x-console-token` header).
#
# Without it the kernel generates a random per-boot token and delivers it
# to the browser shell as a SameSite cookie. That works for the SPA, but an
# external client — an AG-UI consumer, a smoke script — has no way to learn
# it. Set this to drive the HTTP surface from outside the browser.
#
# This gates the KERNEL, not the runtime. It has nothing to do with
# HERMES_API_SERVER_KEY above.
CONSOLE_KERNEL_TOKEN=

# ── Published port ───────────────────────────────────────────────────────
# Host port for the kernel. The browser shell is served here too.
CONSOLE_PORT=6770
